{
  "configurations": [
    {
      "name": "debug web app",
      "request": "launch",
      "type": "rdbg",
      "rdbgPath": "bundle exec rdbg",
      "script": "bin/rails server",
      "args": ["-p", "3000", "-b", "0.0.0.0"],
      "useBundler": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "RAILS_ENV": "development"
      }
    },
    {
      "name": "debug worker",
      "request": "launch",
      "type": "rdbg",
      "rdbgPath": "bundle exec rdbg",
      "script": "$(ruby -e 'puts Gem.bindir')/aws_sqs_active_job",
      "args": ["--queue", "default"],
      "useBundler": true,
      "cwd": "${workspaceFolder}",
      "env": {
        "RAILS_ENV": "development"
      }
    }
  ]
}